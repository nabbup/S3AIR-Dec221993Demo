// rendering!!!!! woot woot
function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	// menu selection stuff
	if (objA0.update_address == 0x004a5c)
	{
		Renderer.drawSprite("dec93_start", px, py, 0x30, SPRITE_FLAG_PRIO, 0xff00)
		if (objA0.state == 1)
			Renderer.drawSprite(stringformat("dec93_%d", global.next_bluespheres), px+0x68, py, 0x30, SPRITE_FLAG_PRIO, 0xff00)
		return true
	}
	// Blue Spheres results texts
	if ((global.game_mode & 0x7f) == 0x48 || (global.game_mode & 0x7f) == 0)
	{
		if (objA0.update_address == 0x02eac8) // "SPECIAL STAGE" gets replaced by "GAME OVER"
		{
			Renderer.drawSprite("dec93_gameover", px, py, 0x30, SPRITE_FLAG_PRIO, renderQueue)
			return true
		}
		if (objA0.update_address == 0x02ea50) // "COOL! YOU DID IT!"
		{
			if (objA0.animation.sprite == 0x23)
			{
				Renderer.drawSprite("dec93_cool", px, py, 0x30, SPRITE_FLAG_PRIO, renderQueue)
				return true
			}
			if (objA0.animation.sprite == 0x24)
			{
				Renderer.drawSprite("dec93_youmadeit", px, py, 0x30, SPRITE_FLAG_PRIO, renderQueue)
				return true
			}
		}
		if (objA0.update_address == 0x02ea50 || objA0.update_address == 0x02ec1e) && (objA0.animation.sprite >= 0x12 && objA0.animation.sprite <= 0x16)
			return true
		if ((global.game_mode & 0x7f) == 0)
		{
			// evil and fucked up but i don't want to have the ROM graphics show up when fading back to the title screen
			u8 gameback = global.game_mode
			global.game_mode = 0x48
			base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
			global.game_mode = gameback
			return true
		}
	}
	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}